{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(api|database)(/.*)?",
      "status": 404
    },
    {
      "src": "/(router\\.php|README\\.md|composer\\.json|\\.env.*)",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "src": "/(index|users|api|file|install)\\.php",
      "dest": "/api/$1.php"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=3600"
      },
      "continue": true
    }
  ]
}
